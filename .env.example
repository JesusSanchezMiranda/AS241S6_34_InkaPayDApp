# API key de Etherscan V2 para Ethereum Mainnet y Polygon.
# Sepolia y Hoodi usan Blockscout v2 sin clave; los enlaces abren Etherscan.
# Vite publica variables VITE_* en el cliente; usa una key limitada a dominios/cuotas.
VITE_ETHERSCAN_API_KEY=

# Opcional: para elegir Etherscan en las testnets, cambia a etherscan (requiere la clave).
VITE_TESTNET_HISTORY_PROVIDER=blockscout
